# Deploy-only image for the API on a host that builds from GitHub (e.g. Render).
# Streamlit Community Cloud does not use this file: it runs app/streamlit_app.py directly.
# Same as Dockerfile, except the database is downloaded at build time (data/ is not in git)
# and the server listens on $PORT.
FROM python:3.13-slim

COPY --from=ghcr.io/astral-sh/uv:0.9.21 /uv /uvx /bin/

WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    PYTHONUNBUFFERED=1

# Dependencies first so this layer is cached until the lockfile changes.
COPY pyproject.toml uv.lock .python-version ./
RUN uv sync --frozen --no-dev --no-install-project

COPY src/ src/
COPY app/ app/
COPY docs/glossary.md docs/glossary.md

# Public derived file (built from the UCI Online Retail II dataset), attached to a GitHub Release.
ARG DB_URL=https://github.com/analysthrishi/ai-analyst-agent/releases/download/data-v1/retail.duckdb
RUN mkdir -p data outputs/charts \
    && python -c "import os, sys, urllib.request as u; u.urlretrieve(os.environ['DB_URL'], 'data/retail.duckdb'); n = os.path.getsize('data/retail.duckdb'); print('downloaded', n, 'bytes'); sys.exit(0 if n > 1000000 else 'database download looks wrong')" \
    && /app/.venv/bin/python -c "import duckdb; duckdb.connect('data/retail.duckdb', read_only=True).execute('SELECT COUNT(*) FROM sales').fetchone()"

RUN useradd --create-home --uid 1000 app && chown -R app:app outputs
USER app

ENV PATH="/app/.venv/bin:$PATH"
EXPOSE 8000
# Render sets PORT; fall back to 8000 elsewhere.
CMD ["sh", "-c", "exec uvicorn --app-dir src api:app --host 0.0.0.0 --port ${PORT:-8000}"]
